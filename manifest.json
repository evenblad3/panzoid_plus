{
    "manifest_version": 3,
    "version_name": "2.1",
    "version": "2.2",

    "name": "panzoid+",
    "short_name": "pz+",
    "description": "a browser extension for clipmaker 3 that lets you enhance your projects by adding new visual effects !",
    "author": "wzrterfx",

    "icons": {
        "16": "blobs/icons/16x16.png",
        "32": "blobs/icons/32x32.png",
        "48": "blobs/icons/48x48.png",
        "128": "blobs/icons/128x128.png"
    },

    "action": {
        "default_popup": "internal/private/extension.html",
        "default_title": "open panzoid+"
    },

    "permissions": [ "clipboardWrite", "storage" ],

    "host_permissions": [
        "https://*.panzoid.com/tools/gen3/clipmaker*",
        "https://*.panzoid.com/legacy/gen3/clipmaker.html*"
    ],

    "web_accessible_resources": [
        {
            "resources": [ "blobs/effects.json", "blobs/library.effect", "blobs/effects/*" ],
            "matches": [ "https://*.panzoid.com/*" ]
        }
    ],

    "content_scripts": [
        {
            "matches": [ "https://*.panzoid.com/legacy/gen3/clipmaker.html*" ],
            "js": [
                "internal/public/effect.js",
                "internal/public/catalogue.js",
                "internal/private/hooks.js"
            ],
            "run_at": "document_start",
            "world": "MAIN",
            "all_frames": true
        },
        {
            "matches": [
                "https://*.panzoid.com/tools/gen3/clipmaker*",
                "https://*.panzoid.com/legacy/gen3/clipmaker.html*"
            ],
            "js": [ "internal/private/bridge.js" ],
            "run_at": "document_start",
            "all_frames": true
        }
    ]
}