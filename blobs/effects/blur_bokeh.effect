uniform float force;
uniform float highlight;
uniform float stochastic;

void main() {
    vec2 round_uv = round_offset();

    float count_inverse = 1.0 / float( fetches );
    float radius = remap( force, 0.0, 32.0 ) * 0.01;
    vec2 spread = radius * round_uv;

    vec4 total = vec4( 0.0 );
    float weight_total = 0.0;

    for( int it = 0; it < int( fetches ); ++it ) {
        vec2 offset = vogel_scatter( it, count_inverse, stochastic ) * spread;

        vec4 texel = sample_it( vUv + offset );
        float weight = pow( length( texel.xyz ), remap( highlight, 0.5, 4.0 ) );

        total += texel * weight;
        weight_total += weight;
    }

    gl_FragColor = ( weight_total > 0.0 ) ? total / weight_total : sample_it( vUv );
}
