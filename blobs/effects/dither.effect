uniform float force;

uniform vec3 tint;
uniform float saturation;
uniform float posterize;

uniform float scale;

void main() {
    vec4 texel = sample_texel( vUv );

    float levels = exp2( mix( 8.0, 1.0, posterize ) ) - 1.0;
    float threshold = mix( 0.5,
        get_dither( vUv * get_resolution() / remap_float( scale, 1.0, 8.0 ) ), force );

    vec3 shade = mix( vec3( get_luma( texel.xyz ) ), texel.xyz,
        remap_float( saturation, 0.0, 2.0 ) );
    vec3 made = clamp(
        floor( clamp( shade, 0.0, 1.0 ) * levels + threshold ) / levels, 0.0, 1.0
    );

    gl_FragColor = vec4( made * tint, texel.w );
}
