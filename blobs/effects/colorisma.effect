uniform float force;

uniform float saturation;

uniform float low;
uniform float mid;
uniform float high;

float hermite( float along, float from, float to, float slope_from, float slope_to ) {
    float square = along * along;
    float cube = square * along;

    return ( 2.0 * cube - 3.0 * square + 1.0 ) * from
        + ( cube - 2.0 * square + along ) * slope_from * 0.25
        + ( -2.0 * cube + 3.0 * square ) * to
        + ( cube - square ) * slope_to * 0.25;
}

float get_curve( float shade ) {
    float first = low * 4.0;
    float second = ( mid - low ) * 4.0;
    float third = ( high - mid ) * 4.0;
    float fourth = ( 1.0 - high ) * 4.0;

    float along = fract( min( shade, 1.0 - c_epsilon ) * 4.0 );

    if( shade < 0.25 ) return hermite( along, 0.0, low, first, ( first + second ) * 0.5 );
    if( shade < 0.5 ) {
        return hermite( along, low, mid, ( first + second ) * 0.5, ( second + third ) * 0.5 );
    }
    if( shade < 0.75 ) {
        return hermite( along, mid, high, ( second + third ) * 0.5, ( third + fourth ) * 0.5 );
    }

    return hermite( along, high, 1.0, ( third + fourth ) * 0.5, fourth );
}

void main() {
    vec4 texel = sample_texel( vUv );

    vec3 graded = clamp(
        vec3( get_curve( texel.x ), get_curve( texel.y ), get_curve( texel.z ) ), 0.0, 1.0
    );
    graded = clamp(
        mix( vec3( get_luma( graded ) ), graded, remap_float( saturation, 0.0, 2.0 ) ), 0.0, 1.0
    );

    gl_FragColor = vec4( mix( texel.xyz, graded, clamp( force, 0.0, 1.0 ) ), texel.w );
}
