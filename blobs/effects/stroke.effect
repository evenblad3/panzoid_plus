uniform float force;
uniform vec3 tint;
uniform float thickness;
uniform float feather;
uniform float stochastic;

void main() {
    vec4 texel = sample_it( vUv );

    vec2 spread = remap( thickness, 0.0, 8.0 ) * 0.01 * round_offset();
    float count_inverse = 1.0 / float( fetches );

    float nearest = 1.0;

    for( int it = 0; it < int( fetches ); ++it ) {
        vec2 offset = vogel_scatter( it, count_inverse, stochastic );

        if( sample_it( vUv + offset * spread ).w > 0.5 ) {
            nearest = min( nearest, length( offset ) );
        }
    }

    float soft = max( clamp( feather, 0.0, 1.0 ), c_epsilon );
    float ink = smoothstep( 1.0, 1.0 - soft, nearest )
        * ( 1.0 - texel.w ) * clamp( force, 0.0, 1.0 );

    float alpha = texel.w + ink;

    gl_FragColor = ( alpha > 0.0 )?
        vec4( ( texel.xyz * texel.w + tint * ink ) / alpha, alpha ): texel;
}