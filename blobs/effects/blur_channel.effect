uniform float force;

uniform float red;
uniform float green;
uniform float blue;

uniform float stochastic;

void main() {
    vec2 spread = remap_float( force, 0.0, 32.0 ) * 0.01 / get_texel_round();
    vec3 reach = remap_float( vec3( red, green, blue ), 0.0, 2.0 );

    float count_inverse = 1.0 / float( fetches );

    vec3 total = vec3( 0.0 );
    float alpha = 0.0;

    for( int it = 0; it < int( fetches ); ++it ) {
        vec2 offset = get_vogel_scatter( it, count_inverse, stochastic ) * spread;
        vec4 middle = sample_texel( vUv + offset * reach.y );

        total.x += sample_texel( vUv + offset * reach.x ).x;
        total.y += middle.y;
        total.z += sample_texel( vUv + offset * reach.z ).z;

        alpha += middle.w;
    }

    gl_FragColor = vec4( total * count_inverse, alpha * count_inverse );
}
