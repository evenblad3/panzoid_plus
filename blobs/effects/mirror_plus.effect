uniform float force;

uniform vec2 position;
uniform vec2 scale;
uniform float rotation;

uniform float segments;
uniform float twist;

void main() {
    float aspect = get_texel_round().x;

    vec2 centered = vUv - 0.5;
    centered.x *= aspect;

    float radius = length( centered );
    float wedge = c_pi2 / max( segments, 1.0 );

    float folded = abs( mod( atan( centered.y, centered.x )
        + remap_signed( twist, 1.0 ) * radius * c_pi2, wedge ) - wedge * 0.5 );

    float turn = radians( rotation );
    vec2 spot = mat2( cos( turn ), -sin( turn ), sin( turn ), cos( turn ) )
        * vec2( cos( folded ), sin( folded ) ) * radius;

    spot.x /= aspect;
    spot = spot / max( remap_float( scale, 0.1, 5.0 ), vec2( c_epsilon ) )
        + remap_signed( position, 1.0 ) + 0.5;

    gl_FragColor = mix( sample_texel( vUv ),
        sample_texel( 1.0 - abs( mod( spot, 2.0 ) - 1.0 ) ), clamp( force, 0.0, 1.0 ) );
}
