uniform float force;
uniform float segments;
uniform float rotation;
uniform float twist;
uniform vec2 position;
uniform vec2 scale;

void main() {
    float aspect = aspect_ratio();

    vec2 centered = vUv - 0.5;
    centered.x *= aspect;

    float radius = length( centered );
    float wedge = c_turn / max( segments, 1.0 );

    float folded = abs( mod( atan( centered.y, centered.x )
        + remap( twist, -1.0, 1.0 ) * radius * c_turn, wedge ) - wedge * 0.5 );

    float turn = radians( rotation );
    vec2 spot = mat2( cos( turn ), -sin( turn ), sin( turn ), cos( turn ) )
        * vec2( cos( folded ), sin( folded ) ) * radius;

    spot.x /= aspect;
    spot = spot / max( remap( scale, 0.1, 5.0 ), vec2( c_epsilon ) )
        + remap( position, -1.0, 1.0 ) + 0.5;

    gl_FragColor = mix( sample_it( vUv ), sample_it( 1.0 - abs( mod( spot, 2.0 ) - 1.0 ) ),
        clamp( force, 0.0, 1.0 ) );
}