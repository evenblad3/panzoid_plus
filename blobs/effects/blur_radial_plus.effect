uniform vec2 center;
uniform float force;
uniform float highlight;
uniform float stochastic;

void main() {
    float count_inverse = 1.0 / float( fetches );

    vec4 total = vec4( 0.0 );

    for( int it = 0; it < int( fetches ); ++it ) {
        float along = ( float( it ) + scatter( stochastic ) ) * count_inverse;
        total += sample_it( vUv + ( remap( center, -1.0, 2.0 ) - vUv ) * along * along * force );
    }

    gl_FragColor = total * remap( highlight, 0.1, 2.0 ) * count_inverse;
}
