uniform float force;

uniform float highlight;

uniform vec2 position;

uniform float stochastic;

void main() {
    vec2 toward = remap_float( position, -1.0, 2.0 ) - vUv;
    float count_inverse = 1.0 / float( fetches );

    vec4 total = vec4( 0.0 );
    float weight_total = 0.0;

    for( int it = 0; it < int( fetches ); ++it ) {
        float at = ( float( it ) + get_stochastic_scatter( stochastic ) ) * count_inverse;

        vec4 texel = sample_texel( vUv + toward * at * at * force );
        float weight = pow( length( texel.xyz ), exp2( remap_signed( highlight, 2.0 ) ) );

        total += texel * weight;
        weight_total += weight;
    }

    gl_FragColor = ( weight_total > 0.0 )? total / weight_total: sample_texel( vUv );
}
