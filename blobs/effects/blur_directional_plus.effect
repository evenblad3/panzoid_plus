uniform float force;
uniform vec2 direction;
uniform float highlight;
uniform float stochastic;

void main() {
    vec2 along = remap( direction, -1.0, 1.0 )
        * remap( force, 0.0, 8.0 ) * 0.05 * round_offset();

    float span_inverse = 1.0 / max( float( fetches ) - 1.0, 1.0 );

    vec4 total = vec4( 0.0 );
    float weight_total = 0.0;

    for( int it = 0; it < int( fetches ); ++it ) {
        vec4 texel = sample_it( vUv + along
            * ( ( float( it ) + scatter( stochastic ) ) * span_inverse - 0.5 ) );
        float weight = pow( length( texel.xyz ), remap( highlight, 0.5, 4.0 ) );

        total += texel * weight;
        weight_total += weight;
    }

    gl_FragColor = ( weight_total > 0.0 )? total / weight_total: sample_it( vUv );
}