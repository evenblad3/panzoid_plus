uniform float force;

uniform float highlight;

uniform vec2 direction;

uniform float stochastic;

void main() {
    vec2 along = remap_signed( direction, 1.0 )
        * remap_float( force, 0.0, 8.0 ) * 0.05 / get_texel_round();

    float span_inverse = 1.0 / max( float( fetches ) - 1.0, 1.0 );

    vec4 total = vec4( 0.0 );
    float weight_total = 0.0;

    for( int it = 0; it < int( fetches ); ++it ) {
        vec4 texel = sample_texel( vUv + along
            * ( ( float( it ) + get_stochastic_scatter( stochastic ) ) * span_inverse - 0.5 ) );
        float weight = pow( length( texel.xyz ), exp2( remap_signed( highlight, 2.0 ) ) );

        total += texel * weight;
        weight_total += weight;
    }

    gl_FragColor = ( weight_total > 0.0 )? total / weight_total: sample_texel( vUv );
}
