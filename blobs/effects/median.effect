uniform float force;
uniform float radius;
uniform float stochastic;

void main() {
    vec4 keep = sample_it( vUv );

    vec2 reach = max( remap( radius, 1.0, 64.0 ), 1.0 ) * texel_size();
    float count_inverse = 1.0 / float( fetches );

    float brightness[ fetches ];

    for( int it = 0; it < int( fetches ); ++it ) {
        brightness[ it ] = luma_it( vUv + vogel_scatter( it, count_inverse, stochastic ) * reach );
    }

    int middle = 0;
    int closest = int( fetches );

    for( int it = 0; it < int( fetches ); ++it ) {
        int below = 0;

        for( int other = 0; other < int( fetches ); ++other ) {
            if( brightness[ other ] < brightness[ it ] ) below += 1;
        }

        int gap = below - int( fetches ) / 2;
        if( gap < 0 ) gap = -gap;

        if( gap < closest ) {
            closest = gap;
            middle = it;
        }
    }

    vec4 picked = sample_it( vUv + vogel_scatter( middle, count_inverse, stochastic ) * reach );

    gl_FragColor = mix( keep, vec4( picked.xyz, keep.w ), clamp( force, 0.0, 1.0 ) );
}