uniform float force;
uniform vec3 tint;
uniform float shift;
uniform float feather;
uniform float stochastic;

void main() {
    vec4 texel = sample_it( vUv );

    vec2 round_uv = round_offset();
    vec2 spread = remap( feather, 0.0, 0.25 ) * round_uv;
    vec2 away = remap( shift, 0.0, 0.25 ) * round_uv;

    float count_inverse = 1.0 / float( fetches );

    float ahead = 0.0;
    float behind = 0.0;

    for( int it = 0; it < int( fetches ); ++it ) {
        vec2 jitter = vogel_scatter( it, count_inverse, stochastic ) * spread;

        ahead += sample_it( vUv + away + jitter ).w;
        behind += sample_it( vUv - away + jitter ).w;
    }

    float sheen = clamp( abs( ahead - behind ) * count_inverse
        * remap( force, 0.0, 3.0 ), 0.0, 1.0 ) * texel.w;

    gl_FragColor = vec4( mix( texel.xyz, tint, sheen ), texel.w );
}