uniform float force;
uniform vec3 tint;
uniform float angle;
uniform vec2 caps;
uniform float stochastic;

void main() {
    vec4 keep = sample_it( vUv );

    float turn = radians( angle );
    vec2 along = vec2( cos( turn ), -sin( turn ) ) * round_offset();

    vec2 ends = caps * 0.1;
    float count_inverse = 1.0 / float( fetches );

    vec4 body = vec4( 0.0 );

    for( int it = 0; it < int( fetches ); ++it ) {
        vec2 at = vUv - along
            * mix( -ends.x, ends.y, ( float( it ) + scatter( stochastic ) ) * count_inverse );

        if( at != clamp( at, 0.0, 1.0 ) ) continue;

        vec4 texel = sample_it( at );
        body = mix( body, texel, texel.w );
    }

    body.xyz *= tint;

    gl_FragColor = mix( keep, body, clamp( force, 0.0, 1.0 ) );
}