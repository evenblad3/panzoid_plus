uniform float force;

uniform float radius;
uniform float angle;
uniform float ridge;

uniform float stochastic;

vec3 get_flow( vec2 texel, vec2 step_uv, float cosine, float sine ) {
    float left = sample_texel_luma( texel - vec2( step_uv.x, 0.0 ) );
    float right = sample_texel_luma( texel + vec2( step_uv.x, 0.0 ) );
    float down = sample_texel_luma( texel - vec2( 0.0, step_uv.y ) );
    float up = sample_texel_luma( texel + vec2( 0.0, step_uv.y ) );

    vec2 slope = vec2( right - left, up - down );
    float steep = length( slope );

    if( steep < c_epsilon ) return vec3( 0.0 );

    vec2 way = vec2( -slope.y, slope.x ) / steep;

    return vec3( way.x * cosine - way.y * sine, way.x * sine + way.y * cosine, steep );
}

void main() {
    vec2 step_uv = max( remap_float( radius, 1.0, 64.0 ), 1.0 ) * get_texel_step();

    float turn = radians( angle );
    float cosine = cos( turn );
    float sine = sin( turn );

    vec3 flow = get_flow( vUv, step_uv, cosine, sine );
    float carry = mix( 1.0, smoothstep( 0.0, 0.25, flow.z ), clamp( ridge, 0.0, 1.0 ) );

    vec2 stride = remap_float( force, 0.0, 200.0 ) * 0.01 * carry
        / ( float( fetches ) * get_texel_round() );

    vec2 jitter = ( get_stochastic() - 0.5 ) * stochastic;

    vec2 ahead = vUv + stride * jitter.x;
    vec2 behind = vUv + stride * jitter.y;

    vec4 total = sample_texel( vUv );
    float count = 1.0;

    for( int it = 0; it < int( fetches ) / 2; ++it ) {
        ahead += get_flow( ahead, step_uv, cosine, sine ).xy * stride;
        behind -= get_flow( behind, step_uv, cosine, sine ).xy * stride;

        total += sample_texel( ahead ) + sample_texel( behind );
        count += 2.0;
    }

    gl_FragColor = total / count;
}
