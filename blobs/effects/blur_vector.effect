uniform float force;
uniform float angle;
uniform float ridge;
uniform float radius;
uniform float stochastic;

void main() {
    vec2 step_uv = max( remap( radius, 1.0, 64.0 ), 1.0 ) * texel_size();

    float left = luma_it( vUv - vec2( step_uv.x, 0.0 ) );
    float right = luma_it( vUv + vec2( step_uv.x, 0.0 ) );
    float down = luma_it( vUv - vec2( 0.0, step_uv.y ) );
    float up = luma_it( vUv + vec2( 0.0, step_uv.y ) );

    vec2 slope = vec2( right - left, up - down );
    float steep = length( slope );

    float turn = radians( angle );
    float cosine = cos( turn );
    float sine = sin( turn );

    vec2 way = ( steep > c_epsilon )? vec2( -slope.y, slope.x ) / steep: vec2( 0.0 );
    way = vec2( way.x * cosine - way.y * sine, way.x * sine + way.y * cosine );

    float carry = mix( 1.0, smoothstep( 0.0, 0.25, steep ), clamp( ridge, 0.0, 1.0 ) );
    vec2 spread = way * carry * remap( force, 0.0, 200.0 ) * 0.01 * round_offset();

    float span_inverse = 1.0 / max( float( fetches ) - 1.0, 1.0 );
    vec4 total = vec4( 0.0 );

    for( int it = 0; it < int( fetches ); ++it ) {
        total += sample_it( vUv
            + spread * ( ( float( it ) + scatter( stochastic ) ) * span_inverse - 0.5 ) );
    }

    gl_FragColor = total / float( fetches );
}