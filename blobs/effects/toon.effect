uniform float force;

uniform vec3 tint;
uniform float saturation;
uniform float posterize;
uniform float exposure;

uniform float feather;

void main() {
    vec4 texel = sample_texel( vUv );

    float steps = max( remap_float( posterize, 2.0, 16.0 ), 2.0 );
    float bright = pow( clamp( get_luma( texel.xyz ), 0.0, 1.0 ),
        exp2( remap_signed( exposure, 1.5 ) ) );

    float along = bright * ( steps - 1.0 );
    float edge = max( clamp( feather, 0.0, 1.0 ), c_epsilon ) * 0.5;

    float stepped = ( floor( along ) + smoothstep( 0.5 - edge, 0.5 + edge, fract( along ) ) )
        / ( steps - 1.0 );

    vec3 shade = clamp( mix( vec3( stepped ), texel.xyz * stepped / max( bright, c_epsilon ),
        remap_float( saturation, 0.0, 2.0 ) ), 0.0, 1.0 );

    gl_FragColor = vec4( mix( texel.xyz, shade * tint, clamp( force, 0.0, 1.0 ) ), texel.w );
}
