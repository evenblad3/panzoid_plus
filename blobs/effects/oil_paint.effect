uniform float force;
uniform float sharpness;

void main() {
    vec4 texel = sample_it( vUv );

    float strength = remap( force, 2.0, 16.0 );
    float zeta = 1.0 / strength;

    float edge = ( float( fetches ) - 1.0 ) * 0.5;
    vec2 step_uv = texel_size();

    vec4 mean[ 8 ];
    vec3 square[ 8 ];

    for( int it = 0; it < 8; ++it ) {
        mean[ it ] = vec4( 0.0 );
        square[ it ] = vec3( 0.0 );
    }

    for( int row = 0; row < int( fetches ); ++row ) {
        for( int column = 0; column < int( fetches ); ++column ) {
            vec2 spread = vec2( float( column ) - edge, float( row ) - edge ) * zeta;

            float fall = exp( -3.125 * dot( spread, spread ) );
            if( fall < 0.0001 ) continue;

            vec3 near = clamp( sample_it( clamp(
                vUv + spread * strength * step_uv, 0.0, 1.0 ) ).xyz, 0.0, 1.0 );

            float flat_x = zeta - zeta * spread.x * spread.x;
            float flat_y = zeta - zeta * spread.y * spread.y;

            float weight[ 8 ];

            weight[ 0 ] = max( 0.0, spread.y + flat_x );
            weight[ 2 ] = max( 0.0, -spread.x + flat_y );
            weight[ 4 ] = max( 0.0, -spread.y + flat_x );
            weight[ 6 ] = max( 0.0, spread.x + flat_y );

            vec2 turned = 0.707107 * vec2( spread.x - spread.y, spread.x + spread.y );

            flat_x = zeta - zeta * turned.x * turned.x;
            flat_y = zeta - zeta * turned.y * turned.y;

            weight[ 1 ] = max( 0.0, turned.y + flat_x );
            weight[ 3 ] = max( 0.0, -turned.x + flat_y );
            weight[ 5 ] = max( 0.0, -turned.y + flat_x );
            weight[ 7 ] = max( 0.0, turned.x + flat_y );

            float total = 0.0;

            for( int it = 0; it < 8; ++it ) {
                weight[ it ] *= weight[ it ];
                total += weight[ it ];
            }

            if( total <= 0.0 ) continue;
            fall /= total;

            for( int it = 0; it < 8; ++it ) {
                float taken = weight[ it ] * fall;

                mean[ it ] += vec4( near * taken, taken );
                square[ it ] += near * near * taken;
            }
        }
    }

    float bite = remap( sharpness, 1.0, 14.0 );

    vec3 made = vec3( 0.0 );
    float carried = 0.0;

    for( int it = 0; it < 4; ++it ) {
        if( mean[ it ].w <= c_epsilon ) continue;

        vec3 tone = mean[ it ].xyz / mean[ it ].w;
        vec3 apart = abs( square[ it ] / mean[ it ].w - tone * tone );

        float evenness = 1.0 / ( 1.0
            + pow( min( 2048.0 * ( apart.x + apart.y + apart.z ), 64.0 ), bite ) );

        made += tone * evenness;
        carried += evenness;
    }

    gl_FragColor = vec4(
        ( carried > 0.0 )? clamp( made / carried, 0.0, 1.0 ): texel.xyz, texel.w );
}
