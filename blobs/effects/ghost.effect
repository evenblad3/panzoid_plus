uniform float force;

uniform vec3 tint;

uniform vec2 position;
uniform float scale;
uniform float feather;

uniform float stochastic;

void main() {
    vec4 texel = sample_texel( vUv );

    vec2 spread = remap_float( feather, 0.0, 0.25 ) / get_texel_round();

    vec2 placed = remap_float( position, -1.0, 2.0 );
    vec2 pulled = placed + ( vUv - placed ) * exp2( remap_signed( scale, 2.0 ) );

    float count_inverse = 1.0 / float( fetches );
    vec4 copy = vec4( 0.0 );

    for( int it = 0; it < int( fetches ); ++it ) {
        copy += sample_texel(
            pulled + get_vogel_scatter( it, count_inverse, stochastic ) * spread
        );
    }

    copy *= count_inverse;

    float shade = copy.w * clamp( force, 0.0, 1.0 );
    float alpha = shade + texel.w * ( 1.0 - shade );

    gl_FragColor = ( alpha > 0.0 )? vec4( ( copy.xyz * tint * shade
        + texel.xyz * texel.w * ( 1.0 - shade ) ) / alpha, alpha ): texel;
}
